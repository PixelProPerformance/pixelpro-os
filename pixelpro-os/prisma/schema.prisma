// PixelPro OS, esquema de dados.
// Começa em SQLite pra subir rápido. Pra escalar no Railway, troque provider por "postgresql"
// e aponte DATABASE_URL pro Postgres do Railway (veja README).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("COLLABORATOR") // ADMIN, COLLABORATOR, CLIENT
  clientId     String? // preenchido quando role = CLIENT
  client       Client?  @relation(fields: [clientId], references: [id])
  createdAt    DateTime @default(now())
  comments     Comment[]
  decisions    Approval[] @relation("ApprovalDecider")
  createdPosts Post[]     @relation("PostCreator")
}

model Client {
  id        String   @id @default(cuid())
  name      String
  handle    String?
  color     String   @default("#7c6cff")
  market    String   @default("br") // br, pt, en
  ramo      String   @default("")
  assuntos  String   @default("")
  tom       String   @default("")
  cta       String   @default("")
  template  String   @default("") // JSON do modelo do Production Pro (identidade visual)
  createdAt DateTime @default(now())
  users     User[]
  posts     Post[]
  accounts  SocialAccount[]
  deck      TopicDeck?
}

model Post {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id])
  title       String
  format      String    @default("Carrossel") // Carrossel, Reels, Story, Post, Video
  networks    String    @default("[]")        // JSON: ["instagram","facebook",...]
  status      String    @default("IDEA")       // IDEA, PRODUCTION, PENDING_APPROVAL, APPROVED, SCHEDULED, PUBLISHED, FAILED
  scheduledAt DateTime?
  captionIG   String    @default("")
  captionTh   String    @default("")
  hashtags    String    @default("")
  design      String    @default("")           // JSON do Production Pro (textos, posições, fundo)
  roteiro     String    @default("")
  createdById String?
  createdBy   User?     @relation("PostCreator", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  approvals   Approval[]
  comments    Comment[]
  publishLogs PublishLog[]
}

model Approval {
  id          String   @id @default(cuid())
  postId      String
  post        Post     @relation(fields: [postId], references: [id])
  state       String   @default("PENDING") // PENDING, APPROVED, CHANGES_REQUESTED
  note        String   @default("")
  deciderId   String?
  decider     User?    @relation("ApprovalDecider", fields: [deciderId], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime @default(now())
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  body      String
  createdAt DateTime @default(now())
}

model SocialAccount {
  id           String    @id @default(cuid())
  clientId     String
  client       Client    @relation(fields: [clientId], references: [id])
  platform     String    // instagram, facebook, threads, youtube, tiktok, linkedin
  displayName  String    @default("")
  accessToken  String    @default("")
  refreshToken String    @default("")
  expiresAt    DateTime?
  meta         String    @default("{}") // JSON: pageId, igUserId, channelId, etc
  status       String    @default("CONNECTED")
  createdAt    DateTime  @default(now())
}

model TopicDeck {
  id        String   @id @default(cuid())
  clientId  String   @unique
  client    Client   @relation(fields: [clientId], references: [id])
  topics    String   @default("[]") // JSON de assuntos possíveis salvos
  used      String   @default("[]")
  updatedAt DateTime @updatedAt
}

model PublishLog {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id])
  platform  String
  ok        Boolean  @default(false)
  externalId String  @default("")
  detail    String   @default("")
  dryRun    Boolean  @default(true)
  createdAt DateTime @default(now())
}
